# Copy to `.env` at the repository root and replace every value. `.env` is never committed (04 §8).
# Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Environment ------------------------------------------------------------------------------------
# local | test | staging | production
ENVIRONMENT=local

# --- Local Postgres (docker compose only) ------------------------------------------------------------
# The superuser exists only to create the two roles on first start (ADR-011).
POSTGRES_ADMIN_PASSWORD=replace-me
CYBERATHLETE_MIGRATOR_PASSWORD=replace-me
CYBERATHLETE_APP_PASSWORD=replace-me

# --- API (apps/api) ----------------------------------------------------------------------------------
# The running API connects as cyberathlete_app. It refuses to boot as a superuser, a BYPASSRLS role or
# a table owner (ADR-011).
DATABASE_URL=postgresql+psycopg://cyberathlete_app:replace-me@127.0.0.1:5432/cyberathlete

# Alembic, seeds and backfills only. Never present in a deployed API's environment (ADR-011).
MIGRATION_DATABASE_URL=postgresql+psycopg://cyberathlete_migrator:replace-me@127.0.0.1:5432/cyberathlete

# At least 32 random characters. The API refuses to boot on a known development default (04 §8).
JWT_SECRET=replace-me-with-at-least-32-random-bytes

# How many times to try reaching Postgres at boot before refusing to start.
DATABASE_CONNECT_ATTEMPTS=10

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Transactional email (05 §5). No provider is chosen yet (open question 10): `folder` writes each message as
# JSON into apps/api/.mail/ (git-ignored), `memory` keeps them for tests. A staging or production API refuses
# to boot until a provider exists.
# EMAIL_TRANSPORT=folder
# EMAIL_FOLDER=apps/api/.mail
# Where links in emails point: the app's deep-link scheme (apps/mobile/app.json).
# APP_LINK_BASE=cyberathlete://

# --- Mobile (apps/mobile) ----------------------------------------------------------------------------
# Inlined into the app bundle at build time, so it is never a secret. Expo reads it from apps/mobile/.env
# or from the EAS build profile. Debug builds default to http://localhost:8000 over adb reverse; a
# release build refuses to start without an https URL here (04 §5).
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# --- Tests only --------------------------------------------------------------------------------------
# Integration tests create and drop throwaway roles, so they need the admin user of the LOCAL or CI
# container. Never point this at a managed database (ADR-011).
TEST_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:replace-me@127.0.0.1:5432/cyberathlete
