{
  "name": "@cyberathlete/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "eas-build-pre-install": "bash scripts/eas-build-pre-install.sh",
    "start": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first expo start --dev-client --localhost",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean --no-install",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "db:generate": "drizzle-kit generate",
    "lint:fixtures": "node scripts/check-lint-fixtures.mjs",
    "check:catalogs": "node scripts/check-catalogs.mjs",
    "check:seed-version": "node scripts/check-seed-version.mjs",
    "render:brand": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/render-brand-assets.mjs",
    "check:platform-files": "node scripts/check-platform-files.mjs .",
    "check:release-cleartext": "node scripts/check-release-cleartext.mjs",
    "check:release-bundle-diagnostics": "node scripts/check-release-bundle-diagnostics.mjs"
  },
  "dependencies": {
    "@cyberathlete/core-native": "workspace:*",
    "@formatjs/intl-getcanonicallocales": "3.2.12",
    "@formatjs/intl-locale": "5.3.11",
    "@formatjs/intl-pluralrules": "6.3.15",
    "@tanstack/react-query": "5.102.8",
    "drizzle-orm": "0.45.2",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "26.4.2",
    "i18next-icu": "2.4.4",
    "intl-messageformat": "11.2.15",
    "react": "19.2.3",
    "react-i18next": "17.0.13",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-libsodium": "1.7.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@cyberathlete/shared": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/libsodium-wrappers-sumo": "^0.8.2",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "3.0.0",
    "babel-preset-expo": "~57.0.11",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "libsodium-wrappers-sumo": "0.8.4",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  }
}
